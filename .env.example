# LUFT environment — copy to .env.local and fill in. Connectors self-enable when
# their credentials are present, so an empty file runs mock-only.

# --- eBay Motors (Browse API) ------------------------------------------------
# Create a keyset at https://developer.ebay.com (Application Keys).
# Setting both flips the eBay connector on; the Marketplace then shows live cars.
EBAY_APP_ID=
EBAY_CERT_ID=
# EBAY_ENV=production        # or "sandbox"
# EBAY_MARKETPLACE=EBAY_US

# --- Scrape sources via Apify actors -----------------------------------------
# One token powers every Apify source. Wire each site's actor either in code
# (src/lib/luft/connectors/apify-sites.ts) or by setting its actor-id secret
# below (no code change). BaT is pre-wired in code.
APIFY_TOKEN=
# APIFY_ACTOR_BAT=silentflow/bringatrailer-scraper
# APIFY_ACTOR_CARS_AND_BIDS=
# APIFY_ACTOR_PCARMARKET=
# APIFY_ACTOR_HEMMINGS=
# APIFY_ACTOR_CLASSICCARS=
# APIFY_ACTOR_AUTOTRADER=

# --- Data seam ----------------------------------------------------------------
# Mock/seed connector is OFF by default. Set to 1 to opt in (e.g. local dev
# against an empty D1); leave unset in production.
# LUFT_ENABLE_MOCK=1

# --- Read from Cloudflare D1 (worker-ingested data) ---------------------------
# Set all three to make the app read pre-ingested rows from D1 (via its HTTP API)
# instead of aggregating connectors live on each request. Leave blank to keep the
# in-memory path. The API token needs D1 read access.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_API_TOKEN=

# --- Workshop AI (Claude) ------------------------------------------------------
# Powers the "Ask the Workshop" air-cooled 911 Q&A. Set in Vercel (server-only).
# ANTHROPIC_API_KEY=sk-ant-...

# --- List your car (seller submissions → Worker → D1/R2) -----------------------
# The Sell flow uploads photos to the Worker (R2) and submits listings through it.
# NEXT_PUBLIC_WORKER_URL is the deployed ingest Worker's origin (browser uploads +
# server submit). The two secrets must match the Worker's SUBMIT_SECRET/ADMIN_SECRET.
# ADMIN_KEY is the /admin page key you present in the URL (?key=...) — keep it
# distinct from WORKER_ADMIN_SECRET so the worker secret never reaches the browser.
# NEXT_PUBLIC_WORKER_URL=https://luft-ingest.<your-subdomain>.workers.dev
# WORKER_SUBMIT_SECRET=
# WORKER_ADMIN_SECRET=
# ADMIN_KEY=
