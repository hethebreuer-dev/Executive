# falgen environment — copy to falgen/.env and fill in. .env is gitignored.

# Your Stability AI API key. Stays on the server; never sent to the browser.
# Find it at https://platform.stability.ai/account/keys
STABILITY_KEY=

# Password to unlock the local UI. If you leave this blank, the server prints
# a temporary random password on each start instead.
APP_PASSWORD=

# Port for the local server (default 5178). It always binds to 127.0.0.1 only.
# PORT=5178
